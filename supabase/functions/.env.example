# Copy this file to .env (same folder), fill it in, then run ./scripts/deploy.sh
# It's uploaded to Supabase as Edge Function secrets with:
#   supabase secrets set --env-file supabase/functions/.env
#
# Keep test-mode and live-mode values in separate files (e.g. .env and .env.live) —
# Stripe has separate keys and webhook secrets for each mode.
# Never commit your real .env file (it's in .gitignore).
#
# Do NOT add SUPABASE_* variables here; Supabase injects those automatically.
# Leave optional variables commented out rather than blank.

# ── Required ──────────────────────────────────────────────────────────────────

# Restricted Stripe keys (see README → "Restricted API keys")
STRIPE_SECRET_KEY_CHECKOUT=rk_test_...
STRIPE_SECRET_KEY_WEBHOOK=rk_test_...

# Signing secret of your Stripe webhook endpoint. You get this AFTER deploying
# (see README step 5), so leave this commented out on the first deploy.
# STRIPE_WEBHOOK_SECRET=whsec_...

# Your website's URL, no trailing slash
SITE_URL=https://www.example.org

# ── Optional ──────────────────────────────────────────────────────────────────

# Origin allowed to call create-checkout from a browser (recommended). Default: *
# ALLOWED_ORIGIN=https://www.example.org

# Where Stripe sends donors after paying / if they abandon checkout.
# Defaults: SITE_URL/thank-you and SITE_URL/donate
# SUCCESS_URL=https://www.example.org/thank-you
# CANCEL_URL=https://www.example.org/donate

# Tax-receipt text for large one-time gifts (US nonprofits)
# ORG_LEGAL_NAME=Example Foundation
# ORG_EIN=12-3456789
# TAX_RECEIPT_THRESHOLD_CENTS=25000

# Newsletter opt-in: comma-separated provider ids, plus each provider's own variables.
# Leave unset to disable (and set SHOW_NEWSLETTER_OPT_IN = false in the donation widget).
# NEWSLETTER_PROVIDERS=squarespace
# SQUARESPACE_API_KEY=...
# SQUARESPACE_USER_AGENT=MyOrg-Donations/1.0
